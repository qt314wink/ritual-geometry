{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ritual-geometry.local/schema/machine-job.v0.json",
  "title": "Ritual Geometry Machine Job v0",
  "description": "A product-neutral draft handoff from authored geometry to a bounded fabrication consumer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "family", "release_state", "evidence_state", "coordinate_frame", "layers", "source"],
  "properties": {
    "schema_version": {"const": "rg.machine-job.v0"},
    "job_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "release_state": {"enum": ["draft", "release", "withdrawn"]},
    "evidence_state": {"enum": ["static_pass; physical_unrun", "physical_observed", "blocked"]},
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "version"],
      "properties": {
        "family_id": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "coordinate_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "mode", "jig_mm", "origin"],
      "properties": {
        "units": {"const": "mm"},
        "mode": {"const": "absolute"},
        "jig_mm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}
        },
        "origin": {"const": "lower-left"}
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "layer_id", "visual_role", "registration_points_mm", "operation_order"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "layer_id": {"type": "string"},
          "visual_role": {"type": "string"},
          "registration_points_mm": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/point"}},
          "operation_order": {"const": ["registration", "interior", "outer_perimeter", "laser_off"]}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcode_path", "gcode_sha256", "controller"],
      "properties": {
        "gcode_path": {"type": "string"},
        "gcode_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "controller": {"type": "string"}
      }
    },
    "material_profile": {"type": ["object", "null"]}
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
    }
  }
}
